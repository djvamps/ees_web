---
import FacebookIcon from '../assets/icons/FacebookIcon.astro';
import InstagramIcon from '../assets/icons/InstagramIcon.astro';
import TailcastLogo from '../assets/logos/TailcastLogo.astro';
import TiktokIcon from '../assets/icons/TiktokIcon.astro';

const footerData = [
  {
    title: 'La Escuela',
    items: [
      { name: 'Nuestra Historia', href: '#' },
      { name: 'Misión y Visión', href: '/#features' },
      { name: 'Metodología', href: '/metodologia' },
      { name: 'Admisión 2026', href: '/ees_2026_4.pdf' },
    ],
  },
  {
    title: 'Comunidad',
    items: [
      { name: 'Nuestro Equipo', href: '#' },
      { name: 'Galería de Actividades', href: '#' },
      { name: 'Preguntas Frecuentes', href: '#' },
      { name: 'Política de Privacidad', href: '#' },
    ],
  },
  {
    title: 'Contacto',
    items: [
      { name: 'Trabaja con Nosotros', href: '#' },
      { name: 'Únete a la Comunidad', href: '#' },
    ],
  },
];
---

<footer aria-label="Site footer">
  <div class="bg-bgDark1 radius-for-skewed pt-10 pb-5 lg:pt-16 lg:pb-6">
    <div class="content-container">
      <div class="flex flex-wrap">
        <div
          class="order-1 mb-16 flex w-full flex-nowrap justify-center gap-x-8 sm:flex-wrap sm:gap-x-16 lg:order-2 lg:mb-0 lg:w-2/3 lg:justify-end"
        >
          {
            footerData.map((section, i) => (
              <div
                class:list={[
                  'text-center sm:mb-16 sm:w-auto md:mb-0 lg:text-left',
                  i === 2 ? 'hidden sm:block' : 'w-1/2 sm:w-auto',
                ]}
              >
                <h3 class="text-primaryText mb-5 text-lg font-bold">{section.title}</h3>
                <ul>
                  {section.items.map((item) => (
                    <li class="mb-3">
                      <a
                        class="cursor-pointer text-sm text-gray-400 hover:text-gray-300"
                        href={item.href}
                      >
                        {item.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <div class="order-2 w-full lg:order-1 lg:mb-0 lg:w-1/3">
          <div class="flex grow basis-0 items-center justify-center lg:justify-start">
            <div class="mr-2 text-6xl text-white">
              <TailcastLogo />
            </div>
            <div class="font-['Inter'] text-xl font-bold text-white">E.E.S.</div>
          </div>
          <p
            class="mx-auto mt-4 mb-6 text-center leading-loose text-gray-400 sm:w-[22rem] lg:mx-0 lg:w-[20rem] lg:text-left xl:w-[24rem]"
          >
            Sembramos hoy la nueva humanidad del mañana <a
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-100"
              aria-label="Dark Admin Dashboard (opens in new tab)">Únete.</a
            >
          </p>
          <div
            class="mb-10 flex w-full items-center justify-center gap-3 sm:w-auto lg:justify-start"
          >
            <label for="footer-email" class="sr-only">Email address</label>
            <input
              type="email"
              id="footer-email"
              placeholder="Your email address"
              class="form-input h-12 py-0 text-sm sm:!w-56 md:!w-52 xl:!w-60"
            />
            <button
              class="text-primaryText bg-primaryColor hover:bg-primaryColorHover h-12 cursor-pointer rounded-xl px-5 text-sm font-semibold transition"
              type="button"
              data-open-modal
              aria-label="Subscribe to newsletter"
            >
              Subscribe
            </button>
          </div>
          <div class="flex justify-center lg:justify-start">
            <a
              href="#"
              class="outlined-button border-mainBorderSubtle mr-2 inline-block h-10 w-10 cursor-pointer p-2 pt-[0.55rem]"
              aria-label="Facebook"
            >
              <FacebookIcon />
            </a>
            <a
              href="https://www.tiktok.com/@ecoescuelaser"
              class="outlined-button border-mainBorderSubtle mr-2 inline-block h-10 w-10 cursor-pointer p-2 pt-[0.55rem] pl-[0.55rem]"
              aria-label="Tiktok"
            >
              <TiktokIcon />
            </a>
            <a
              href="https://www.instagram.com/eco.escuela.ser/"
              class="outlined-button border-mainBorderSubtle mr-2 inline-block h-10 w-10 cursor-pointer p-2 pt-[0.55rem] pl-[0.55rem]"
              aria-label="Instagram"
            >
              <InstagramIcon />
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Logo Pengrafic centrado al final -->
    <div class="flex w-full justify-center pt-3 pb-1">
      <img
        src="/pengrafic_26.svg"
        alt="Pengrafic"
        width="128"
        height="40"
        class="block h-auto w-28 sm:w-32"
      />
    </div>
  </div>
</footer>
