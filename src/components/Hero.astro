---
import { Image } from 'astro:assets';
import heroBg from '../assets/images/nina_sembrando.webp';
import BackgroundGradientAnimation from './BackgroundGradientAnimation.astro';
---

<section
  class="relative flex w-full items-center justify-center overflow-hidden pb-24 sm:pb-32 md:pb-44 lg:pb-0"
  id="home"
>
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <!-- prettier-ignore -->
    <Image
  src={heroBg}
  alt="Eco Escuela S.E.R."
  class="h-full w-full object-cover object-[center_40%]"
  widths={[400, 800, 1024]}
  sizes="(max-width: 640px) 400px, (max-width: 1024px) 800px, 1024px"
  quality={70}
  fetchpriority="high"
  loading="eager"
></Image>
    <div class="hero-bg-overlay absolute inset-0" style="opacity: 0.85;"></div>
    <div class="absolute inset-0 opacity-90 mix-blend-screen">
      <BackgroundGradientAnimation />
    </div>
  </div>

  <div
    class="relative z-10 flex w-full flex-col items-center justify-center pt-16 text-center md:w-[50rem] md:pt-16 lg:pt-20 xl:w-[56.25rem]"
  >
    <div class="hero-fade-in" style="--delay: 0s">
      <span
        class="block-subtitle mt-2 mb-4 block max-w-full px-4 text-center text-[0.55rem] text-balance drop-shadow-[0_0_2px_rgba(0,0,0,0.85)] sm:mt-16 sm:mb-6 sm:text-[0.65rem]"
      >
        COMUNIDAD, NATURALEZA Y APRENDISAJE VIVO
      </span>
    </div>
    <div class="hero-fade-in mx-auto max-w-3xl px-4" style="--delay: 0.05s">
      <h1
        class="xs:text-4xl text-[1.7rem] leading-[1.1] font-bold tracking-tight [text-shadow:0_2px_10px_rgb(0_0_0_/_60%)] md:text-5xl lg:text-6xl"
      >
        <span class="text-heroText">Sembramos hoy la nueva</span><br />
        <span class="text-heroText">humanidad del mañana</span>
      </h1>
    </div>
    <div class="hero-fade-in" style="--delay: 0.1s">
      <p
        class="mx-auto mt-7 max-w-2xl px-4 text-sm leading-relaxed text-white drop-shadow-[0_0_3px_rgba(0,0,0,0.8)] sm:text-base"
      >
        En Eco Escuela Ser creemos que cada niño merece crecer en un espacio donde su esencia sea
        respetada, su curiosidad sea celebrada y su conexión con la naturaleza sea profunda.
        Ofrecemos una educación integral basada en metodologías innovadoras que despiertan el
        potencial único de cada ser humano.
      </p>
    </div>
    <div class="hero-fade-in" style="--delay: 0.15s">
      <div class="mt-10 mb-24 flex flex-col justify-center gap-2 sm:mb-40 sm:flex-row">
        <a
          href="/ees_2026_4.pdf"
          class="btn-animado btn-color-left relative mr-0 mb-2 flex h-12 w-72 items-center justify-center rounded-xl text-sm transition-all duration-300 hover:shadow-[0_0_30px_rgba(109,62,6,0.4)] sm:mr-2 sm:mb-0 sm:w-44 lg:mr-3"
          aria-label="Get started"
        >
          <span class="btn-text">Admisión 2026</span>
        </a>

        <button
          class="btn-animado btn-color-right relative flex h-12 w-72 cursor-pointer items-center justify-center rounded-xl text-sm font-bold transition-all duration-300 sm:w-44"
          data-open-modal
          aria-label="Live demo"
        >
          <span class="btn-text">Quiero Visitar</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-bg-overlay {
    background:
      linear-gradient(135deg, rgb(77 108 31 / 0.15) 0%, transparent 50%),
      linear-gradient(
        180deg,
        rgb(28 39 11 / 0.75) 0%,
        /* Menos oscuro arriba */ rgb(40 56 16 / 0.2) 45%,
        /* Muy transparente en el centro (donde está la niña) */ rgb(28 39 11 / 0.4) 75%,
        /* Transparencia suave */ rgb(28 39 11 / 0.85) 100%
          /* Oscuro al final para conectar con la siguiente sección */
      );
  }

  .hero-fade-in {
    opacity: 0;
    transform: translateY(10px);
    animation: heroFadeIn 0.5s ease forwards;
    animation-delay: var(--delay);
  }

  @keyframes heroFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 1. CONFIGURACIÓN DEL CONTENEDOR PADRE */
  .btn-animado {
    position: relative;
    overflow: hidden;
    z-index: 1;
    border: none;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex !important; /* Forzamos que mantenga comportamiento de bloque/flex */
    align-items: center;
    justify-content: center;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  /* 2. EL DEGRADADO QUE GIRA (FONDO TRASERO) */
  .btn-animado::before {
    content: '';
    position: absolute;
    top: -150%;
    left: -150%;
    width: 400%;
    height: 400%;
    background: conic-gradient(
      from 180deg at 50% 50%,
      #e7961b 0deg,
      #feca57 90deg,
      #04661c 180deg,
      #e79b0d 360deg
    );
    animation: rotarDegradado 3s linear infinite;
    z-index: -1;
    border-radius: 50%;
  }

  /* 3. MÁSCARA INTERNA CON FLUJO NORMAL (YA NO ES ABSOLUTO) */
  /* Forzamos el comportamiento global de la máscara interna */
  :global(.btn-text) {
    position: relative !important;
    z-index: 10 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100% !important;
    height: 100% !important;
    border-radius: inherit !important;
    border: 2px solid transparent !important;
    background-clip: padding-box !important;
  }

  /* Colores específicos inyectados globalmente para asegurar prioridad */
  :global(.btn-color-left .btn-text) {
    background-color: #d19f4a !important;
    color: white !important;
  }

  :global(.btn-color-right .btn-text) {
    background-color: #283810 !important;
    color: white !important;
  }

  @keyframes rotarDegradado {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
</style>
