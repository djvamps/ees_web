---
import { Image } from 'astro:assets';
import heroBg from '../assets/images/nina-sembrando.png';
import BackgroundGradientAnimation from './BackgroundGradientAnimation.astro';
---

<section
  class="relative flex w-full items-center justify-center overflow-hidden pb-24 sm:pb-32 md:pb-44 lg:pb-0"
  id="home"
>
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <Image
      src={heroBg}
      alt="Eco Escuela S.E.R."
      class="h-full w-full object-cover object-[center_40%]"
      widths={[400, 800, 1024]}
      sizes="(max-width: 640px) 400px, (max-width: 1024px) 800px, 1024px"
      quality={70}
      fetchpriority="high"
      loading="eager"
    />
    <div class="hero-bg-overlay absolute inset-0" style="opacity: 0.85;"></div>
    <div class="absolute inset-0 opacity-90 mix-blend-screen">
      <BackgroundGradientAnimation />
    </div>
  </div>

  <div
    class="relative z-10 flex w-full flex-col items-center justify-center pt-16 text-center md:w-[50rem] md:pt-16 lg:pt-20 xl:w-[56.25rem]"
  >
    <div class="hero-fade-in" style="--delay: 0s">
      <span
        class="block-subtitle mt-2 mb-4 block max-w-full px-4 text-center text-[0.55rem] text-balance [text-shadow:0_2px_6px_rgb(0_0_0_/_50%)] sm:mt-16 sm:mb-6 sm:text-[0.65rem]"
      >
        COMUNIDAD, NATURALEZA Y APRENDISAJE VIVO
      </span>
    </div>
    <div class="hero-fade-in mx-auto max-w-3xl px-4" style="--delay: 0.05s">
      <h1
        class="xs:text-4xl text-[1.7rem] leading-[1.1] font-bold tracking-tight [text-shadow:0_2px_10px_rgb(0_0_0_/_60%)] md:text-5xl lg:text-6xl"
      >
        <span class="text-heroText">Sembramos hoy la nueva</span><br />
        <span class="text-heroText">humanidad del mañana</span>
      </h1>
    </div>
    <div class="hero-fade-in" style="--delay: 0.1s">
      <p class="mx-auto mt-7 max-w-2xl px-4 text-sm leading-relaxed text-white sm:text-base">
        En Eco Escuela Ser creemos que cada niño merece crecer en un espacio donde su esencia sea
        respetada, su curiosidad sea celebrada y su conexión con la naturaleza sea profunda.
        Ofrecemos una educación integral basada en metodologías innovadoras que despiertan el
        potencial único de cada ser humano.
      </p>
    </div>
    <div class="hero-fade-in" style="--delay: 0.15s">
      <div class="mt-10 mb-24 flex flex-col justify-center gap-2 sm:mb-40 sm:flex-row">
        <a
          href="/ees_2026_4.pdf"
          class="contained-button mr-0 mb-2 h-12 w-72 text-sm transition-all duration-300 hover:shadow-[0_0_30px_rgba(109,62,6,0.4)] sm:mr-2 sm:mb-0 sm:w-44 lg:mr-3"
          aria-label="Get started"
        >
          Admisión 2026
        </a>
        <button
          class="text-primaryText bg-bgDark2 hover:bg-bgDark3 border-primaryColor flex h-12 w-72 cursor-pointer items-center justify-center rounded-xl border border-solid text-sm font-bold transition sm:w-44"
          data-open-modal
          aria-label="Live demo"
        >
          Quiero Visitar
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-bg-overlay {
    background:
      linear-gradient(135deg, rgb(77 108 31 / 0.3) 0%, transparent 50%),
      linear-gradient(
        180deg,
        rgb(28 39 11 / 0.92) 0%,
        rgb(40 56 16 / 0.78) 38%,
        rgb(28 39 11 / 0.88) 72%,
        rgb(28 39 11) 100%
      );
  }

  .hero-fade-in {
    opacity: 0;
    transform: translateY(10px);
    animation: heroFadeIn 0.5s ease forwards;
    animation-delay: var(--delay);
  }

  @keyframes heroFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
