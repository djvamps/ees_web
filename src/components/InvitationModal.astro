---
import CheckArrowIcon from '../assets/icons/CheckArrowIcon.astro';
import CloseIcon from '../assets/icons/CloseIcon.astro';
import TailcastLogo from '../assets/logos/TailcastLogo.astro';
---

<dialog id="invitation-modal" class="modal-backdrop" aria-labelledby="modal-title">
  <div
    class="xs:w-[90vw] xs:h-auto xs:max-w-[25rem] xs:rounded-2xl xs:pt-8 bg-bgDarkTransparentLighter main-border-gray-darker xs:block relative flex h-screen w-screen flex-col justify-start overflow-hidden rounded-none px-6 pt-[11vh] pb-8 backdrop-blur-xl lg:w-[53.125rem] lg:max-w-none lg:px-10 lg:pt-8 xl:w-[57.5rem] 2xl:w-[68.75rem] 2xl:px-16 2xl:py-12"
  >
    <button class="modal-close-button" id="modal-close" aria-label="Close modal">
      <CloseIcon />
    </button>
    <div class="flex">
      <div class="hidden w-1/2 pl-4 lg:inline 2xl:pl-0">
        <h2 class="text-primaryText mt-6 mb-2 text-4xl font-bold tracking-normal 2xl:text-5xl">
          Agenda una Cita
        </h2>
        <h2 class="text-secondaryColor text-4xl font-bold tracking-normal 2xl:text-5xl">Guiada</h2>
        <ul class="text-primaryText mt-8 mb-6 2xl:mt-12">
          <li class="mb-4 flex"><CheckArrowIcon /><span>Visita: Lun 9:00am - 01:00pm</span></li>
          <li class="mb-4 flex"><CheckArrowIcon /><span>Reserva Cita: 931 314 153</span></li>
          <li class="mb-4 flex">
            <CheckArrowIcon /><span>Niveles: Jardín de Infancia y Primaria </span>
          </li>
        </ul>
      </div>
      <div class="flex w-full flex-col items-center justify-center pt-0 lg:w-1/2">
        <div class="mb-6 flex items-center justify-start pr-6 lg:hidden">
          <div class="mr-2 text-8xl text-white">
            <TailcastLogo />
          </div>
          <div class="font-['Inter'] text-3xl font-bold text-white">E.E.S.</div>
        </div>
        <h3
          class="text-primaryText mb-5 text-center text-xl leading-snug font-bold 2xl:mb-7 2xl:text-2xl"
          id="modal-title"
        >
          Reserva tu visita
        </h3>
        <div class="-m-2 mt-4 flex flex-wrap lg:mt-0">
          <form
            id="invitation-form"
            action="https://formspree.io/f/xlgywdob"
            method="POST"
            class="-m-2 mt-4 flex w-full flex-wrap lg:mt-0"
          >
            <!-- CONTENEDOR DE CAMPOS (Esto es lo que se ocultará) -->
            <div id="form-content" class="flex w-full flex-col">
              <!-- Tu input real de correo -->
              <div class="mx-auto w-full p-2 sm:w-4/5">
                <label for="modal-email" class="sr-only">Email address</label>
                <input
                  class="form-input w-full py-4 text-center font-medium text-black"
                  type="email"
                  id="modal-email"
                  name="email"
                  placeholder="Deja tu email"
                  required
                />
              </div>

              <!-- Tu botón real de enviar -->
              <div class="mx-auto mt-4 w-full p-2 sm:w-4/5">
                <button
                  id="modal-submit-btn"
                  type="submit"
                  aria-label="Join now"
                  class="text-primaryText shadow-4xl bg-primaryColor hover:bg-primaryColorHover focus:ring-secondaryColor/40 w-full cursor-pointer rounded-xl px-6 py-4 font-semibold transition duration-200 ease-in-out focus:ring"
                >
                  Enviar Ahora
                </button>
              </div>
            </div>
            <!-- Cierre del form-content -->

            <!-- TU MENSAJE DE ÉXITO -->
            <div
              id="form-status"
              class="animate-fade-in mt-4 hidden w-full rounded-xl border border-emerald-600 bg-emerald-800/50 p-4 text-center font-medium text-white"
            >
              ¡Gracias! Tu cita ha sido agendada con éxito.
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</dialog>

<script>
  const initModal = () => {
    const modal = document.getElementById('invitation-modal') as HTMLDialogElement;
    const closeBtn = document.getElementById('modal-close');
    let previouslyFocused: HTMLElement | null = null;

    document.querySelectorAll('[data-open-modal]').forEach((btn) => {
      btn.addEventListener('click', () => {
        previouslyFocused = document.activeElement as HTMLElement;
        modal.showModal();
      });
    });

    closeBtn?.addEventListener('click', () => modal.close());

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    modal?.addEventListener('close', () => {
      previouslyFocused?.focus();
    });
  };

  document.addEventListener('astro:page-load', initModal);

  const initInvitationForm = () => {
    const form = document.getElementById('invitation-form') as HTMLFormElement;
    const submitBtn = document.getElementById('modal-submit-btn') as HTMLButtonElement;
    const successMsg = document.getElementById('form-status'); // Ajustado a tu id="form-status"
    const errorMsg = document.getElementById('form-error-message');
    const formContent = document.getElementById('form-content');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault(); // Evita la redirección pase lo que pase

      // El signo ?. evita que el código muera si no encuentra el botón
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Enviando...';
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          formContent?.classList.add('hidden'); // Oculta solo los inputs y el botón
          successMsg?.classList.remove('hidden'); // Muestra el mensaje de éxito
          form.reset();
        } else {
          alert('Hubo un problema. Inténtalo de nuevo.');
        }
      } catch (err) {
        alert('Error de conexión.');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Enviar Ahora';
        }
      }
    });
  };

  document.addEventListener('astro:page-load', initModal);
  document.addEventListener('astro:page-load', initInvitationForm);
</script>
