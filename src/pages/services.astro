      'Formar niños y niñas felices, libres, creativos y conscientes.',
      'Aplicación:',
      'Ritmos naturales, arte y cuento como base del aprendizaje.',
    ],
    process: [
      {
        step: '01',
        title: 'Educación por etapas:',
        description:
          '0 a 7 años (imitación y juego libre); 7 a 14 años (imaginación y sentimiento); 14 a 21 años (pensamiento crítico y libertad interior).',
      },
      {
        step: '02',
        title: 'Aprendizaje artístico y vivencial:',
        description: 'todo se enseña con arte, música, narración y movimiento.',
      },
      {
        step: '03',
        title: 'Ritmo y conexión natural:',
        description: 'la escuela vive los ciclos del día, la semana y las estaciones.',
      },
      {
        step: '04',
        title: 'Sin competencia:',
        description: 'no hay notas ni exámenes, solo acompañamiento.',
      },
      {
        step: '05',
        title: 'Relación maestro-niño:',
        description: 'vínculo cercano basado en la confianza y el ejemplo.',
      },
    ],
    icon: `<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>`,
    image: waldorfImg,
  },
  {
    id: 'visualization',
    label: 'Montessori',
    title: 'Principios montessori',
    description:
      'Creada por María Montessori en 1907, promueve la autonomía, el respeto y el aprendizaje activo.',
    features: [
      'Rol del Educador:',
      'Guía y observador.',
      'Aplicación:',
      'Espacios accesibles, actividades prácticas y materiales naturales.',
    ],

    process: [
      {
        step: '01',
        title: 'Aprendizaje autónomo:',
        description: 'el niño aprende explorando, el adulto acompaña.',
      },
      {
        step: '02',
        title: 'Ambiente preparado:',
        description: 'espacio ordenado, bello y adaptado.',
      },
      {
        step: '03',
        title: 'Materiales sensoriales:',
        description: 'concretos, manipulativos y con propósito.',
      },
      {
        step: '04',
        title: 'Educación integral:',
        description: 'cuerpo, mente y espíritu en equilibrio.',
      },
      {
        step: '05',
        title: 'Libertad con límites:',
        description: 'responsabilidad y respeto como base del disciplina interior.',
      },
    ],
    icon: `<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>`,
    image: montessoriImg,
  },
  {
    id: 'intelligence',
    label: 'Asiri',
    title: 'Principios Asiri',
    description:
      'Creada por María del Carmen Dongo en el Perú. ˝Asiri˛ significa reír o florecer con alegría. Une el alma, la emoción y la naturaleza.',
    features: [
      'Objetivo:',
      'Formar seres humanos felices, libres y conectados con su esencia.g',
      'Aplicación:',
      'Momentos de silencio, rituales naturales y expresión emocional.',
    ],

    process: [
      {
        step: '01',
        title: 'Educación desde el ser:',
        description: 'el foco no es el conocimiento, sino el autoconocimiento',
      },
      {
        step: '02',
        title: 'Aprendizaje vivencial:',
        description: 'se enseña a través de experiencias y emociones.',
      },
      {
        step: '03',
        title: 'Educador consciente:',
        description: 'enseña con coherencia y empatía.',
      },
      {
        step: '04',
        title: 'Ambiente armónico y natural:',
        description: 'espacios cálidos y espirituales. Integración cuerpo-mente-emoción-espíritu.',
      },
    ],
    icon: `<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>`,
    image: asiriImg,
  },
  {
    id: 'integrations',
    label: '3000',
    title: 'Principios 3000',
    description:
      'Creada por Noemí Paymal, antropóloga boliviana. Responde a los nuevos niños y niñas del siglo XXI: sensibles, intuitivos, creativos y conscientes.',
    features: [
      'Objetivo:',
      'Formar personas conscientes, creativas y solidarias.',
