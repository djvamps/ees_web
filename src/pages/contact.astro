---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ScrollUpButton from '../components/ScrollUpButton.astro';
---

<Layout
  title="Contact - Tailcast"
  description="Get in touch with the Tailcast team. We'd love to hear from you."
>
  <Navbar />
  <section class="bg-bgDark2 pt-32 pb-20 md:pt-44">
    <div class="content-container">
      <div class="fade-in">
        <div class="flex flex-col gap-16 lg:flex-row lg:gap-24">
          <div class="lg:w-1/2">
            <span class="block-subtitle">Contactanos</span>
            <h1 class="text-primaryText mt-6 mb-6 text-4xl font-bold lg:text-5xl">
              Ponte en Contacto
            </h1>
            <p class="text-secondaryText mb-12 leading-loose">
              ¿Tienes alguna pregunta o quieres saber más sobre nuestra plataforma de análisis?
              Rellena el formulario y nuestro equipo se pondrá en contacto contigo en un plazo de 24
              horas.
            </p>
            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div
                  class="bg-bgDark3 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg"
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M3 8L10.89 13.26C11.2187 13.4793 11.6049 13.5963 12 13.5963C12.3951 13.5963 12.7813 13.4793 13.11 13.26L21 8M5 19H19C19.5304 19 20.0391 18.7893 20.4142 18.4142C20.7893 18.0391 21 17.5304 21 17V7C21 6.46957 20.7893 5.96086 20.4142 5.58579C20.0391 5.21071 19.5304 5 19 5H5C4.46957 5 3.96086 5.21071 3.58579 5.58579C3.21071 5.96086 3 6.46957 3 7V17C3 17.5304 3.21071 18.0391 3.58579 18.4142C3.96086 18.7893 4.46957 19 5 19Z"
                      stroke="rgb(109, 62, 6)"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-primaryText mb-1 font-bold">Email</h3>
                  <p class="text-secondaryText">ecoescuelasoylibre@gmail.com</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div
                  class="bg-bgDark3 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg"
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M21 10C21 17 12 23 12 23C12 23 3 17 3 10C3 7.61305 3.94821 5.32387 5.63604 3.63604C7.32387 1.94821 9.61305 1 12 1C14.3869 1 16.6761 1.94821 18.364 3.63604C20.0518 5.32387 21 7.61305 21 10Z"
                      stroke="rgb(109, 62, 6)"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                    <path
                      d="M12 13C13.6569 13 15 11.6569 15 10C15 8.34315 13.6569 7 12 7C10.3431 7 9 8.34315 9 10C9 11.6569 10.3431 13 12 13Z"
                      stroke="rgb(109, 62, 6)"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-primaryText mb-1 font-bold">Ubicasion</h3>
                  <p class="text-secondaryText">
                    Limite de Chaclacayo y Chosica<br />Puerta 2 del Club el Aro
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div
                  class="bg-bgDark3 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg"
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M22 16.92V19.92C22.0011 20.1985 21.9441 20.4742 21.8325 20.7294C21.7209 20.9845 21.5573 21.2136 21.3521 21.4019C21.1469 21.5901 20.9046 21.7335 20.6408 21.8227C20.3769 21.9119 20.0974 21.9451 19.82 21.92C16.7428 21.5856 13.787 20.5342 11.19 18.85C8.77383 17.3147 6.72534 15.2662 5.19 12.85C3.49998 10.2412 2.44824 7.271 2.12 4.18C2.09501 3.90347 2.12788 3.62476 2.2165 3.36162C2.30513 3.09849 2.44757 2.85669 2.63477 2.65162C2.82196 2.44655 3.04981 2.28271 3.30379 2.17052C3.55778 2.05833 3.83234 2.00026 4.11 2H7.11C7.59531 1.99523 8.06579 2.16708 8.43376 2.48353C8.80173 2.79999 9.04208 3.23945 9.11 3.72C9.23662 4.68007 9.47145 5.62273 9.81 6.53C9.94455 6.88792 9.97366 7.27691 9.89391 7.65088C9.81415 8.02485 9.62886 8.36811 9.36 8.64L8.09 9.91C9.51356 12.4136 11.5864 14.4864 14.09 15.91L15.36 14.64C15.6319 14.3711 15.9752 14.1858 16.3491 14.1061C16.7231 14.0263 17.1121 14.0555 17.47 14.19C18.3773 14.5286 19.3199 14.7634 20.28 14.89C20.7658 14.9585 21.2094 15.2032 21.5265 15.5775C21.8437 15.9518 22.0122 16.4296 22 16.92Z"
                      stroke="rgb(109, 62, 6)"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-primaryText mb-1 font-bold">Telefono</h3>
                  <p class="text-secondaryText">+1 (51) 931 314 153</p>
                </div>
              </div>
            </div>
          </div>
          <div class="lg:w-1/2">
            <div class="bg-bgDark3 rounded-3xl p-8 sm:p-10" id="contact-wrapper">
              <form id="contact-form">
                <div class="mb-6">
                  <label for="name" class="text-primaryText mb-2 block font-medium">
                    Nombre completo
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Juan Pérez"
                    required
                    autocomplete="name"
                    class="form-input"
                  />
                </div>

                <div class="mb-6">
                  <label for="email" class="text-primaryText mb-2 block font-medium">
                    Correo electrónico
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="juan@ejemplo.com"
                    required
                    autocomplete="email"
                    class="form-input"
                  />
                </div>

                <div class="mb-6">
                  <label for="phone" class="text-primaryText mb-2 block font-medium">
                    Teléfono
                  </label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    placeholder="+51 999 999 999"
                    required
                    autocomplete="tel"
                    class="form-input"
                  />
                </div>

                <div class="mb-8">
                  <label for="message" class="text-primaryText mb-2 block font-medium">
                    Mensaje
                  </label>
                  <textarea
                    id="message"
                    name="message"
                    rows="5"
                    placeholder="Cuéntanos cómo podemos ayudarte..."
                    required
                    class="form-input resize-none"></textarea>
                </div>

                <p id="form-status" class="mb-4 hidden text-sm" aria-live="polite"></p>

                <button type="submit" class="contained-button w-full py-3 text-lg">
                  Enviar mensaje
                </button>
              </form>
              <div
                id="contact-success"
                class="hidden flex-col items-center justify-center py-16 text-center opacity-0 transition-opacity duration-500"
                aria-live="polite"
              >
                <div
                  class="bg-primaryColor/20 mb-6 flex h-20 w-20 items-center justify-center rounded-full"
                >
                  <svg
                    width="40"
                    height="40"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M20 6L9 17L4 12"
                      stroke="rgb(109, 62, 6)"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </div>
                <h3 class="text-primaryText mb-3 text-2xl font-bold">Message sent!</h3>
                <p class="text-secondaryText max-w-sm leading-relaxed">
                  Thank you for reaching out. We'll get back to you within 24 hours.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ===================== SECTION A - Office Locations ===================== -->
  <section class="bg-bgDark2 pt-10 pb-20">
    <div class="content-container">
      <div class="fade-in mb-14 text-center">
        <span class="block-subtitle">Eco Escuela S.E.R.</span>
        <h2 class="text-primaryText mt-6 mb-4 text-4xl font-bold lg:text-5xl">
          Informacion Basica
        </h2>
        <p class="text-secondaryText mx-auto max-w-2xl leading-relaxed">
          Comunidad, naturaleza y aprendisaje vivo.
        </p>
      </div>
      <div class="fade-in grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="card group p-8">
          <div
            class="bg-primaryColor/15 mb-5 flex h-12 w-12 items-center justify-center rounded-xl"
          >
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M21 10C21 17 12 23 12 23C12 23 3 17 3 10C3 7.61305 3.94821 5.32387 5.63604 3.63604C7.32387 1.94821 9.61305 1 12 1C14.3869 1 16.6761 1.94821 18.364 3.63604C20.0518 5.32387 21 7.61305 21 10Z"
                stroke="rgb(109, 62, 6)"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M12 13C13.6569 13 15 11.6569 15 10C15 8.34315 13.6569 7 12 7C10.3431 7 9 8.34315 9 10C9 11.6569 10.3431 13 12 13Z"
                stroke="rgb(109, 62, 6)"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <h3 class="text-primaryText mb-1 text-lg font-bold">Niveles</h3>
          <p class="text-secondaryColor mb-3 text-sm font-bold">Headquarters</p>
          <p class="text-secondaryText mb-4 text-sm leading-relaxed">
            Jardin de Infancia<br />Primaria
          </p>
          <div class="text-secondaryText flex items-center gap-2 text-sm">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"></circle>
              <path d="M12 6V12L16 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              ></path>
            </svg>
            Mon–Fri, 9am–6pm PT
          </div>
        </div>
        <div class="card group p-8">
          <div
            class="bg-primaryColor/15 mb-5 flex h-12 w-12 items-center justify-center rounded-xl"
          >
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M21 10C21 17 12 23 12 23C12 23 3 17 3 10C3 7.61305 3.94821 5.32387 5.63604 3.63604C7.32387 1.94821 9.61305 1 12 1C14.3869 1 16.6761 1.94821 18.364 3.63604C20.0518 5.32387 21 7.61305 21 10Z"
                stroke="rgb(109, 62, 6)"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M12 13C13.6569 13 15 11.6569 15 10C15 8.34315 13.6569 7 12 7C10.3431 7 9 8.34315 9 10C9 11.6569 10.3431 13 12 13Z"
                stroke="rgb(109, 62, 6)"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <h3 class="text-primaryText mb-1 text-lg font-bold">Horarios</h3>
          <p class="text-secondaryColor mb-3 text-sm font-bold">Europe</p>
          <p class="text-secondaryText mb-4 text-sm leading-relaxed">
            Lunes a Viernes<br />De 8:00 am. - 1:30 pm.
          </p>
          <div class="text-secondaryText flex items-center gap-2 text-sm">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"></circle>
              <path d="M12 6V12L16 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              ></path>
            </svg>
            Mon–Fri, 9am–6pm GMT
          </div>
        </div>
        <div class="card group p-8">
          <div
            class="bg-primaryColor/15 mb-5 flex h-12 w-12 items-center justify-center rounded-xl"
          >
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M21 10C21 17 12 23 12 23C12 23 3 17 3 10C3 7.61305 3.94821 5.32387 5.63604 3.63604C7.32387 1.94821 9.61305 1 12 1C14.3869 1 16.6761 1.94821 18.364 3.63604C20.0518 5.32387 21 7.61305 21 10Z"
                stroke="rgb(109, 62, 6)"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M12 13C13.6569 13 15 11.6569 15 10C15 8.34315 13.6569 7 12 7C10.3431 7 9 8.34315 9 10C9 11.6569 10.3431 13 12 13Z"
                stroke="rgb(109, 62, 6)"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <h3 class="text-primaryText mb-1 text-lg font-bold">Ubicación</h3>
          <p class="text-secondaryColor mb-3 text-sm font-bold">Asia-Pacific</p>
          <p class="text-secondaryText mb-4 text-sm leading-relaxed">
            Limite de chaclacayo y chosica<br />Puerta 2 del Club el Aro
          </p>
          <div class="text-secondaryText flex items-center gap-2 text-sm">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"></circle>
              <path d="M12 6V12L16 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              ></path>
            </svg>
            Mon–Fri, 9am–6pm SGT
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
  <ScrollUpButton />

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const success = document.getElementById('contact-success');
    const wrapper = document.getElementById('contact-wrapper');
    const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!success || !wrapper || !button) return;

      button.disabled = true;
      button.textContent = 'Enviando...';

      try {
        const formData = new FormData(form);

        const response = await fetch('/api/contacto.json', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(formData)),
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.message || 'No se pudo enviar el mensaje.');
        }

        const wrapperHeight = wrapper.offsetHeight;

        if (wrapperHeight) {
          wrapper.style.minHeight = `${wrapperHeight}px`;
        }

        form.style.transition = 'opacity 0.3s ease';
        form.style.opacity = '0';

        setTimeout(() => {
          form.classList.add('hidden');
          success.classList.remove('hidden');
          success.classList.add('flex');

          requestAnimationFrame(() => {
            success.classList.remove('opacity-0');
            success.classList.add('opacity-100');
          });
        }, 300);
      } catch (error) {
        alert(
          error instanceof Error
            ? error.message
            : 'No se pudo enviar el mensaje. Inténtalo nuevamente.'
        );
      } finally {
        button.disabled = false;
        button.textContent = 'Enviar mensaje';
      }
    });
  </script>
</Layout>
